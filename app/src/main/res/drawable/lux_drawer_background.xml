    <item android:gravity="bottom|start" android:width="260dp" android:height="260dp">
        <shape><gradient android:type="radial" android:gradientRadius="240dp"
            android:startColor="#0EA5E955" android:endColor="#00000000"/></shape>
    </item>
</layer-list>
